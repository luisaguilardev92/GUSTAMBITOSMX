{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!_next/|sprites/|favicon.svg|file.svg|globe.svg|window.svg|manifest.webmanifest|sw.js|gustambitos-icon.*|mastered-crown.png).*)", "destination": "/api" }
  ]
}
